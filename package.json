{
  "name": "atomic-echarts",
  "version": "1.1.4",
  "description": "A collection of atomic ECharts hooks and configurations",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js",
      "default": "./dist/config/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "example": "vite",
    "build": "tsc",
    "typecheck:lib": "tsc --noEmit",
    "typecheck:example": "vue-tsc -p example/tsconfig.json --noEmit",
    "check": "npm run typecheck:lib && npm run typecheck:example",
    "clean:publish": "node scripts/clean-publish.cjs",
    "preview": "vite preview",
    "prepare-publish": "node scripts/prepare-publish.cjs",
    "publish-flat": "npm run clean:publish && npm run build && npm run prepare-publish && cd temp-publish && npm publish",
    "publish-flat-dry": "npm run clean:publish && npm run build && npm run prepare-publish && cd temp-publish && npm publish --dry-run"
  },
  "keywords": [
    "echarts",
    "vue",
    "hooks",
    "atomic"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "echarts": "^6.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "echarts": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vite-plugin-dts": "^2.0.0",
    "vue": "^3.0.0",
    "vue-tsc": "^2.0.0"
  }
}
